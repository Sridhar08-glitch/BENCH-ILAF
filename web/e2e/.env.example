# Settings of the browser tests. Copy to your shell or a CI job; the values below are the local defaults.

# Where the website and the API are (the website must have been started with API_URL pointing at this API).
E2E_WEB_URL=http://localhost:3100
E2E_API_URL=http://localhost:8100/api/v1

# The folder the API writes its e-mails to (EMAIL_FILE_PATH of the API, which only works while DEBUG=true).
E2E_MAIL_DIR=/tmp/bench-mail

# Local runs: use the installed Chrome (no download). On CI leave empty and run `npx playwright install --with-deps chromium`.
E2E_CHANNEL=chrome
# Or point at a browser file:
# E2E_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Against `next dev` pages compile on first visit: give assertions more time (milliseconds, default 10000).
# E2E_EXPECT_TIMEOUT=30000

# One browser at a time by default (the machine and the API limits are small).
# E2E_WORKERS=1

# Keep the accounts the run created instead of asking for their deletion afterwards.
# E2E_KEEP_DATA=1

# Accept the current accessibility findings as the new baseline (review the diff of e2e/a11y/baseline.json afterwards).
# A11Y_UPDATE_BASELINE=1

# --- What the API must be started with for these tests (not read by the tests) ---
# DEBUG=true
# CARDS_DEV_ACTIVATE=true
# EMAIL_FILE_PATH=/tmp/bench-mail
# WEBHOOK_ALLOW_PRIVATE_TARGETS=true
# ALLOW_LOCAL_THROTTLE_CACHE=true
# THROTTLE_RATES_JSON={"auth_login":"100000/min","auth_register":"100000/min","auth_forgot":"100000/min","auth_reset":"100000/min","invite_accept":"100000/min","public_read":"100000/min","public_event":"100000/min","public_lead":"100000/min","slug_check":"100000/min","public_directory":"100000/min","resolve_link":"100000/min","data_download":"100000/min","support_public":"100000/hour","user_read":"100000/min","user_write":"100000/min","user_heavy":"100000/min","user_sensitive":"100000/min","user_create":"100000/hour"}
# And the website of a production build over http:  INSECURE_COOKIES=1

# Address of the API as the browser sees it (public card events, QR images, vCard downloads).
NEXT_PUBLIC_API_URL=http://localhost:8100/api/v1
# Address of the API as the Next.js server sees it (server rendering and the sign-in proxy).
API_URL=http://localhost:8100/api/v1
# Product name shown everywhere.
NEXT_PUBLIC_APP_NAME=BENCH
# Host shown in card addresses and the footer. MUST be set to the real card domain before launch.
# "ilaf.one" below is only a placeholder default; the final card domain has not been chosen.
NEXT_PUBLIC_PUBLIC_HOST=ilaf.one
# Public address of this web app (used for canonical links and Open Graph).
NEXT_PUBLIC_WEB_URL=http://localhost:3100
# Seconds the server keeps a public card before asking the API again (default 15)
# PUBLIC_CARD_REVALIDATE=15

# Google OAuth client id for the Continue with Google buttons (build-time). Empty hides them.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server only (never NEXT_PUBLIC_): same random value as CLIENT_IP_HEADER_SECRET in the backend .env. The web server signs the
# visitor address it forwards to the API with it, so per-visitor limits work. Empty = the address is sent unsigned.
CLIENT_IP_HEADER_SECRET=
# Contact address printed in the privacy policy and terms (/privacy, /terms).
COMPANY_SUPPORT_EMAIL=
# "true" (default) shows "Draft for legal review before launch" on /privacy and /terms. Set to false only after a lawyer approved web/content/legal/*.md.
LEGAL_DRAFT_BANNER=true

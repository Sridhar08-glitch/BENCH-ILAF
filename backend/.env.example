# Copy to .env and edit. Real environment variables win over this file.

# --- core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty for sqlite (ilaf.sqlite3). Example Postgres: postgres://user:pass@localhost:5432/ilaf
DATABASE_URL=

# --- addresses
WEB_BASE_URL=http://localhost:3100
# Absolute URL of this API (used for image and QR links). Empty = use the request host.
API_BASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3100
# Set true behind Cloudflare / a reverse proxy so the real visitor address is used for throttling.
TRUST_PROXY_HEADERS=false

# --- brand (all visible text reads these)
PRODUCT_NAME=BENCH
PRODUCT_FULL_NAME=Business Enhancement Network Cloud Hub
PRODUCT_TAGLINE=Your business. One smart identity.
COMPANY_NAME=iLAF Technologies
COMPANY_SITE=https://ilaf.qa

# --- billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CARDS_GRACE_DAYS=7
# true = buying a plan activates it at once without Stripe (development only)
CARDS_DEV_ACTIVATE=false

# --- email (console backend when EMAIL_HOST is empty)
DEFAULT_FROM_EMAIL=BENCH <no-reply@ilaf.qa>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# --- shared cache for throttling across processes (optional, e.g. redis://localhost:6379/1)
REDIS_URL=

# --- optional S3-compatible media storage (Cloudflare R2). Empty bucket = local media folder.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=

# Sign in with Google (OAuth client id, public, no secret). Empty = off.
GOOGLE_CLIENT_ID=
# Google Wallet pass: issuer id from the Google Pay and Wallet Console plus the service account key (file path or inline JSON).
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_FILE=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# Private folder for data export ZIPs (default: private_exports/ next to manage.py).
# EXPORT_ROOT=

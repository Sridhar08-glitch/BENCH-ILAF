# =============================================================================
# BENCH backend: production environment
# Copy to /srv/bench/app/backend/.env on the server, then:
#     sudo -u bench nano /srv/bench/app/backend/.env
#     sudo chmod 600 /srv/bench/app/backend/.env
# Real environment variables win over this file. Never commit the real file.
# The web app has its own file: env.web.production.example.
#
# Legend:  [REQUIRED] the app does not start or is unsafe without it
#          [RECOMMENDED] works without it, but a feature is silently missing
#          [OPTIONAL] leave empty unless you use the feature
# =============================================================================

# ------------------------------------------------------------------ core
# [REQUIRED] Long random string. Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Also signs the login tokens (JWT), export links and visitor hashes. Changing it later signs everybody out
# and invalidates open export links. Keep a copy in a password manager.
# Missing: the app refuses to start (ImproperlyConfigured).
SECRET_KEY=CHANGE_ME_long_random_string

# [REQUIRED] Must be false in production. true shows error pages with code and serves /media/ from Django.
DEBUG=false

# [REQUIRED] Host names the API answers to, comma separated, no scheme. "127.0.0.1" lets the local health check in.
# Missing/wrong: every request answers 400 "Bad Request (DisallowedHost)".
# TODO(owner): replace with the real API host name.
ALLOWED_HOSTS=api.CHANGE-ME.example,127.0.0.1,localhost

# [REQUIRED] true when nginx sits in front (always on this server). Makes Django believe X-Forwarded-Proto and use
# the client address nginx puts in X-Forwarded-For for throttles and visitor hashes. Forwarded headers are read only
# when the connecting address is one of TRUSTED_PROXY_IPS.
# Never true if gunicorn is reachable from the internet directly (it listens on 127.0.0.1 only here).
TRUST_PROXY_HEADERS=true
# [OPTIONAL] Addresses or CIDR ranges allowed to tell Django who the visitor is. Default: this machine only.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# [OPTIONAL] Extra proxy hops to skip on the right of X-Forwarded-For (for example 1 behind Cloudflare plus nginx). Default 0.
NUM_PROXIES=0
# [OPTIONAL] Random value shared with the web app (CLIENT_IP_HEADER_SECRET in env.web.production.example). When set, the
# visitor address the web server forwards in X-BENCH-Client-IP must be signed, otherwise it is ignored.
CLIENT_IP_HEADER_SECRET=
# [OPTIONAL] true only when Cloudflare really is in front: then CF-Connecting-IP is used.
TRUST_CLOUDFLARE_HEADER=false

# [REQUIRED] true in production: redirects http to https, sends HSTS, marks cookies Secure.
# Needs TRUST_PROXY_HEADERS=true (the app refuses to start otherwise). Leave false until HTTPS works (certbot done).
HTTPS_ONLY=true
# HSTS lifetime in seconds. Start small (300) on the first day, then 31536000 (one year) once everything works.
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# [OPTIONAL] Extra origins allowed to POST to /admin/ over https (full origin with scheme). Normally empty.
CSRF_TRUSTED_ORIGINS=

# ------------------------------------------------------------------ database
# [REQUIRED] PostgreSQL. Empty falls back to the sqlite file, which must NOT be used in production.
# Default on this server: local socket, no password (the Linux user "bench" is the database user "bench").
DATABASE_URL=postgres:///bench
# With a password over TCP instead:  postgres://bench:PASSWORD@127.0.0.1:5432/bench
# Connection reuse in seconds is fixed at 60 in settings.py.

# ------------------------------------------------------------------ addresses
# [REQUIRED] Address of the WEB app as people see it (https, no trailing slash). Used in card links, invite and
# password-reset e-mails, export links and Stripe return pages. Wrong: e-mails contain links to localhost.
# TODO(owner): the card domain is not chosen yet. Card links are WEB_BASE_URL + /c/<name>.
WEB_BASE_URL=https://app.CHANGE-ME.example

# [REQUIRED in production] Public address of THIS API including scheme (no path). Used to build links to uploaded
# pictures, QR images and vCards. Empty = derived from the request host (works, but fragile behind a proxy).
API_BASE_URL=https://api.CHANGE-ME.example

# [REQUIRED] Web origins that may call the signed-in API from a browser (scheme + host, comma separated).
# The web app calls the API from its own server, so this matters only for browser calls (events, QR, vCard).
# Public card endpoints (/api/v1/public/, /plans, /media/) always allow any origin.
CORS_ALLOWED_ORIGINS=https://app.CHANGE-ME.example

# ------------------------------------------------------------------ custom domains (Enterprise), see deploy/CUSTOM_DOMAINS.md
# Customer domains are NEVER listed in ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS or CSRF_TRUSTED_ORIGINS: the web app calls this API with the API's
# own host name, and the browser on a customer domain only uses the public endpoints, which are open to every origin without cookies.
# [REQUIRED for custom domains] The name customers point their CNAME at (must resolve to the Caddy/nginx edge for customer domains).
# Empty = the host of WEB_BASE_URL (right when the same nginx serves customer domains).
CARD_DOMAIN_CNAME_TARGET=
# [OPTIONAL] Fixed address(es) of that edge, comma separated, offered to customers who must use a bare domain (example.com),
# where DNS does not allow a CNAME. Empty = bare domains are told to use a subdomain.
CARD_DOMAIN_A_RECORDS=
# [OPTIONAL] Extra names customers may never claim (this site's web, API and CNAME hosts are always refused).
CARD_DOMAIN_RESERVED_HOSTS=
# [RECOMMENDED] Secret that protects GET /api/v1/domains/allowed, the address Caddy asks before it gets a certificate for a name.
# Same value in /etc/caddy/Caddyfile (__ASK_TOKEN__). Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = only a caller on this machine that sends no proxy header may ask.
DOMAIN_ASK_TOKEN=
# [OPTIONAL] Days a pending domain is re-checked before it expires (7); days the DNS records may be missing before the owner is e-mailed
# and the domain is marked dns_broken (3); days it keeps serving after that (14); hours between re-checks of a verified domain (20);
# seconds per DNS question (4); resolvers to ask instead of the system's (for example 1.1.1.1,8.8.8.8).
# CARD_DOMAIN_PENDING_DAYS=7
# CARD_DOMAIN_BROKEN_DAYS=3
# CARD_DOMAIN_GRACE_DAYS=14
# CARD_DOMAIN_RECHECK_HOURS=20
# CARD_DOMAIN_DNS_TIMEOUT=4
# CARD_DOMAIN_DNS_SERVERS=

# ------------------------------------------------------------------ e-mail (SMTP)
# [REQUIRED for real use] Without EMAIL_HOST every e-mail (sign-up, password reset, invites, lead alerts, export
# links, weekly reports) is only printed to the log and NEVER delivered.
EMAIL_HOST=smtp.CHANGE-ME.example
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
# STARTTLS on port 587. Port 465 (implicit TLS) is not supported by the settings; use 587.
EMAIL_USE_TLS=true
# From address shown to people. The domain needs SPF, DKIM and DMARC (see PRODUCTION_READINESS.md).
DEFAULT_FROM_EMAIL=BENCH <no-reply@ilaf.qa>

# ------------------------------------------------------------------ shared cache (throttles)
# [REQUIRED with more than one gunicorn worker] Redis keeps the rate-limit counters (and the lead hourly cap) shared.
# Without it every worker counts alone, so limits are 3x looser and reset on restart.
# Use a database number that no other app on this server uses (Hope uses 0).
REDIS_URL=redis://127.0.0.1:6379/5

# [OPTIONAL] Override rate limits per scope, one line of JSON. Scopes per visitor address: auth_login auth_register auth_forgot
# auth_reset invite_accept public_read public_event public_lead slug_check public_directory resolve_link auth_google
# data_download. Scopes per signed-in person (defaults 600/min, 120/min, 12/min, 10/min, 60/hour): user_read user_write
# user_heavy user_sensitive user_create.
# NOTE: sign-in and the public card page are called by the WEB SERVER, so Django currently sees one address (127.0.0.1) for all
# of them until the web app forwards the visitor address (PRODUCTION_READINESS.md, blocker B1). Until then keep the
# defaults for these scopes generous enough for real traffic. The line below is the interim setting; delete it after the fix.
# nginx (bench-web.conf) already limits each visitor's sign-in attempts before they reach the app.
THROTTLE_RATES_JSON={"auth_login": "120/min", "auth_register": "60/min", "auth_forgot": "30/min", "auth_reset": "60/min", "invite_accept": "60/min", "auth_google": "120/min", "slug_check": "300/min", "public_read": "2000/min", "public_directory": "600/min"}

# ------------------------------------------------------------------ limits and retention
# [OPTIONAL] Largest accepted picture in pixels (width x height). Default 40 million.
IMAGE_MAX_PIXELS=40000000
# [OPTIONAL] Days of raw visit events kept; older ones are rolled up by the daily prune_analytics job. Default 400.
ANALYTICS_RETENTION_DAYS=400
# [OPTIONAL] Most rows in one contacts spreadsheet. Default 50000.
LEADS_CSV_MAX_ROWS=50000
# [OPTIONAL] How recent a sign-in must be to link Google, export data and similar. Seconds, default 600.
REAUTH_WINDOW_SECONDS=600
# [OPTIONAL] A separate key for login tokens. Empty = SECRET_KEY. Changing it signs everybody out.
JWT_SIGNING_KEY=
# [OPTIONAL] true (default) sends the password-reset mail from a background thread after the answer.
EMAIL_AFTER_RESPONSE=true

# ------------------------------------------------------------------ files
# [REQUIRED in production] Uploaded pictures (photos, logos, covers). nginx serves this folder at /media/.
# Empty = backend/media inside the code folder (also fine, but then keep it out of git; it already is).
MEDIA_ROOT=/srv/bench/data/media
# [REQUIRED in production] Private data-export ZIPs. Must never be served by nginx. Must be writable by "bench".
EXPORT_ROOT=/srv/bench/data/private_exports
# [OPTIONAL] S3-compatible bucket (Cloudflare R2) INSTEAD of the local media folder. When AWS_STORAGE_BUCKET_NAME is set,
# nginx /media/ is not used, and the media backup script has nothing to copy (the bucket is the storage).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=

# ------------------------------------------------------------------ billing (parked)
# [OPTIONAL] Payments are parked by the owner. Leave empty: the checkout answers "not configured".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Plans are yearly Stripe subscriptions that renew by themselves (true). false = one-time payments, the owner pays again each period.
STRIPE_RECURRING=true
# Days a card stays live after a paid period ends (default 7).
CARDS_GRACE_DAYS=7
# [REQUIRED false] true would let ANYONE activate a paid plan for free. Must stay false. (The app also activates plans
# for free when DEBUG=true and no Stripe key is set, another reason DEBUG must be false.)
CARDS_DEV_ACTIVATE=false

# ------------------------------------------------------------------ sign-in and wallet
# [OPTIONAL] Google OAuth client id (public). Empty = "Continue with Google" is off (503 google_not_configured).
# Must be the SAME value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the web file. Authorised JavaScript origin in Google
# Cloud: the web address.
GOOGLE_CLIENT_ID=
# Only if Google changes the address of its public keys.
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# [OPTIONAL] Google Wallet pass. Empty = "Add to Google Wallet" hidden (503 wallet_not_configured).
GOOGLE_WALLET_ISSUER_ID=
# Either a path to the service account key file (chmod 600, owned by bench) ...
GOOGLE_WALLET_SERVICE_ACCOUNT_FILE=
# ... or the JSON itself on one line. One of the two, not both.
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
GOOGLE_WALLET_CLASS_SUFFIX=bench_card
# [OPTIONAL] true (default) stores the pass at Google through the Wallet REST API so a saved pass follows card changes
# (job sync_wallet_passes, needs the Google Wallet API enabled and the service account added as a user in the Wallet
# console). false = the whole pass travels inside the link only and saved passes are never refreshed.
GOOGLE_WALLET_REST_UPDATES=true
# Seconds to wait for Google, tries before an update is given up, hours between full re-checks of every saved pass.
GOOGLE_WALLET_REST_TIMEOUT=10
GOOGLE_WALLET_MAX_ATTEMPTS=6
GOOGLE_WALLET_RECHECK_HOURS=24
# true makes the phone show a short "Card updated" message when a pass changes (default false: silent updates).
GOOGLE_WALLET_NOTIFY_ON_UPDATE=false

# ------------------------------------------------------------------ public API keys and CRM connectors
# Start of every API key (only change it before the first key is made; older keys keep working).
API_KEY_PREFIX=bnch_live_
# [REQUIRED when any CRM client id below is set] A long random value (for example `openssl rand -base64 48`). CRM tokens are
# encrypted at rest with a key derived from it. Changing it later disconnects every CRM (owners connect again).
CRM_ENCRYPTION_KEY=
# A CRM's Connect button shows only when its client id and secret are filled in. Create the OAuth apps as described in
# backend/README.md ("CRM connectors"). The redirect addresses are https://<API host>/api/v1/crm/callback/<hubspot|salesforce|zoho>.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# https://login.salesforce.com (production orgs) or https://test.salesforce.com (sandboxes)
SALESFORCE_LOGIN_URL=https://login.salesforce.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Data centres the owner may pick. Qatar and the Gulf: com or eu.
ZOHO_REGIONS=com,eu,in

# ------------------------------------------------------------------ safety switches
# [REQUIRED false] true lets webhooks target http and private addresses (SSRF risk). Development only. Not set here on purpose.
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Lead form: minimum seconds between page open and submit, and leads per card per hour. They are read with defaults
# (3 and 5) and cannot be set from the environment; change them in settings.py if needed.

# ------------------------------------------------------------------ brand text (all optional, defaults shown)
PRODUCT_NAME=BENCH
PRODUCT_FULL_NAME=Business Enhancement Network Cloud Hub
PRODUCT_TAGLINE=Your business. One smart identity.
COMPANY_NAME=iLAF Technologies
COMPANY_SHORT_NAME=iLAF Tech
COMPANY_SITE=https://ilaf.qa
STATEMENT_DESCRIPTOR_SUFFIX=ILAF TECH

# ------------------------------------------------------------------ logging and monitoring
# WARNING (default) | INFO | ERROR. INFO prints one line per notable event; it never prints passwords or tokens.
LOG_LEVEL=WARNING
# [OPTIONAL] Error reporting. Needs "pip install sentry-sdk" in the venv. Empty = off. No personal data is sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# Read by deploy/check_bench.sh and deploy/alert_down.sh (not by the app): who gets the "BENCH is down" e-mail.
# The mail goes out through the SMTP settings above.
ALERT_EMAIL=CHANGE_ME@example.com

# ------------------------------------------------------------------ settings that are NOT variables (code constants)
# Access token 60 minutes, refresh token 30 days with rotation and blacklist; throttle rates; upload limit 8 MB
# (pictures) and 10 MB request body; invite validity 30 days; reset link 2 hours; export link 24 hours;
# account deletion grace 14 days. They live in backend/ilaf/settings.py.

# --- Browser push notifications (Settings > Notifications). Leave empty to hide the button; nothing else depends on it.
# Make the pair once:  cd /srv/bench/app/backend && .venv/bin/python manage.py generate_vapid_keys
# and paste its three lines here (VAPID_SUBJECT is a mailto: address or https address the push services can contact).
# Keep the private key secret and never change it later (every subscribed browser would stop receiving notifications).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@ilaf.qa

# --- Company e-mails: set to 1 to leave a company's logo out of its e-mails when the logo address cannot be fetched.
EMAIL_LOGO_CHECK=1

# --- Support (tickets by e-mail, live chat). See deploy/README-DEPLOY.md "Support mailbox".
SUPPORT_REPLY_TO=support@ilaf.qa
SUPPORT_IMAP_HOST=
SUPPORT_IMAP_PORT=993
SUPPORT_IMAP_USER=
SUPPORT_IMAP_PASSWORD=
SUPPORT_IMAP_FOLDER=INBOX
SUPPORT_INBOUND_SECRET=
SUPPORT_ALERT_EMAILS=

# --- Back office (staff dashboard). All optional.
# Where deploy/run_job.sh leaves its markers (ok-<job>, fail-<job>, last-<job>); the Jobs tab reads them.
BENCH_STATE_DIR=/srv/bench/state
# Hours a card report may wait before it counts as late.
ABUSE_SLA_HOURS=48
# A support view ends by itself after this many minutes.
SUPPORT_VIEW_MINUTES=30
# Addresses told when a company fills in the public "Talk to us" form (also told about new design requests).
STAFF_NOTIFY_EMAILS=

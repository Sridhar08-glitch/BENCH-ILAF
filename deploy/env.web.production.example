# =============================================================================
# BENCH web app (Next.js): production environment
# Copy to /srv/bench/app/web/.env.production on the server, then:
#     sudo chown bench:bench /srv/bench/app/web/.env.production && sudo chmod 600 /srv/bench/app/web/.env.production
#
# IMPORTANT: every NEXT_PUBLIC_* value is BAKED INTO THE BROWSER FILES when the app is built (`npm run build`).
# Changing one later has no effect until you run deploy.sh again (it rebuilds). API_URL and PUBLIC_CARD_REVALIDATE are
# read when the server runs, so a restart is enough for those two.
#
# Legend:  [REQUIRED] [RECOMMENDED] [OPTIONAL] as in env.production.example
# =============================================================================

# [REQUIRED] Public address of the API as the BROWSER sees it, with /api/v1 at the end, https, no trailing slash.
# Used for card visit events, QR pictures, vCard downloads and picture links.
# Missing: it falls back to http://localhost:8100/api/v1 and public cards cannot save contacts or count visits.
NEXT_PUBLIC_API_URL=https://api.CHANGE-ME.example/api/v1

# [REQUIRED] Address of the API as the web SERVER reaches it. On this server the web app and the API are on the same
# machine, so use the local address (fast, no TLS). The port must match bench-api.service (8101).
# Missing: server pages and sign-in use NEXT_PUBLIC_API_URL instead (works, but takes the long way through nginx).
API_URL=http://127.0.0.1:8101/api/v1

# [REQUIRED] Public address of the web app. Used for canonical links, Open Graph and share previews.
# Missing: links point to http://localhost:3100.
NEXT_PUBLIC_WEB_URL=https://app.CHANGE-ME.example

# [REQUIRED] Short host shown in card addresses and tool pages (display text only: "<host>/<card name>").
# TODO(owner): the card domain has not been chosen. The default "ilaf.one" is a placeholder that does not belong to the
# product. NOTE: that host must really open the card (redirect /<name> to the web app /c/<name>) or the shown address
# is a dead link. See README-DEPLOY.md "Card domain".
NEXT_PUBLIC_PUBLIC_HOST=CHANGE-ME.example

# [OPTIONAL] Product name shown everywhere (default BENCH). Baked at build time.
NEXT_PUBLIC_APP_NAME=BENCH

# [OPTIONAL] Google OAuth client id. Empty hides "Continue with Google". Same value as GOOGLE_CLIENT_ID in the backend file.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# [OPTIONAL] Seconds the server keeps a public card before asking the API again. Default 0 = every visit asks, so an unpublished
# or deleted card disappears at once. Leave it unset unless the API is overloaded: a value above 0 keeps a hidden card on the page.
# PUBLIC_CARD_REVALIDATE=0

# NODE_ENV=production is set by bench-web.service (do not put it in this file). It makes the sign-in cookies Secure.

# [REQUIRED absent] Never set INSECURE_COOKIES in production: it removes the Secure flag from the sign-in cookies.
# INSECURE_COOKIES=1

# Port: fixed by the start command in bench-web.service (next start -p 3101). Not read from this file.

# [OPTIONAL, after the visitor-address change in PRODUCTION_READINESS.md section 9.1] Same value as CLIENT_IP_HEADER_SECRET in the
# backend .env. The web server signs the visitor address it forwards to the API with it. Server side only, never NEXT_PUBLIC_.
CLIENT_IP_HEADER_SECRET=

# [REQUIRED before launch] Contact address printed in the privacy policy and terms (/privacy, /terms). Read when the server runs.
# Missing: the pages show a visible "[support e-mail address to be set]" placeholder.
COMPANY_SUPPORT_EMAIL=

# [RECOMMENDED] "true" (default) shows the banner "Draft for legal review before launch" on /privacy and /terms.
# Set to false ONLY after a lawyer has approved the texts in web/content/legal/*.md (privacy.en.md, privacy.ar.md, terms.en.md, terms.ar.md).
LEGAL_DRAFT_BANNER=true

# Optional: a short version label (for example the release date). Support requests carry it so the team knows which version a customer saw.
NEXT_PUBLIC_BUILD_ID=
